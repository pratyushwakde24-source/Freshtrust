generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  WORKER
  SHOP_OWNER
  DELIVERY_PARTNER
  SUPER_ADMIN
}

enum OrderStatus {
  CREATED
  PREPARING
  LIVE_STREAMING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  UPI
  CARD
  WALLET
  COD
}

enum CutType {
  CURRY_CUT
  BIRYANI_CUT
  BONELESS
  MINCE
  CHOPS
  WHOLE
}

enum MeatType {
  CHICKEN
  MUTTON
  FISH_SEAFOOD
  EXOTIC
  READY_TO_COOK
}

enum LiveStatus {
  OFFLINE
  LIVE
  PAUSED
  COMPLETED
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  phone         String?         @unique
  passwordHash  String
  name          String
  role          Role            @default(CUSTOMER)
  walletBalance Float           @default(0.0)
  loyaltyPoints Int             @default(0)
  isVipMember   Boolean         @default(false)
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  addresses     Address[]
  orders        Order[]
  payments      Payment[]
  reviews       Review[]
  notifications Notification[]
  auditLogs     AuditLog[]
  workerProfile Worker?
  riderProfile  DeliveryPartner?
  shopProfile   Shop?           @relation("ShopOwner")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  latitude     Float
  longitude    Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders Order[]
}

model Shop {
  id             String    @id @default(uuid())
  ownerId        String    @unique
  owner          User      @relation("ShopOwner", fields: [ownerId], references: [id])
  name           String
  code           String    @unique
  city           String
  address        String
  latitude       Float
  longitude      Float
  isActive       Boolean   @default(true)
  commissionRate Float     @default(15.0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workers        Worker[]
  cameras        Camera[]
  inventories    Inventory[]
  orders         Order[]
}

model Camera {
  id          String     @id @default(uuid())
  shopId      String
  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  streamKey   String     @unique
  rtspUrl     String?
  resolution  String     @default("1080p")
  status      LiveStatus @default(OFFLINE)
  createdAt   DateTime   @default(now())

  workers      Worker[]
  liveSessions LiveSession[]
}

model Worker {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  cameraId    String?
  camera      Camera?  @relation(fields: [cameraId], references: [id])
  stationName String
  isAvailable Boolean  @default(true)
  rating      Float    @default(4.9)
  createdAt   DateTime @default(now())

  orders       Order[]
  liveSessions LiveSession[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
}

model Product {
  id           String    @id @default(uuid())
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  name         String
  slug         String    @unique
  meatType     MeatType
  description  String
  pricePerKg   Float
  netWeightGrams Int     @default(500)
  grossWeightGrams Int   @default(550)
  freshnessScore Int     @default(98)
  imageUrl     String
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inventories  Inventory[]
  orderItems   OrderItem[]
  reviews      Review[]
}

model Inventory {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockKg     Float    @default(50.0)
  minAlertKg  Float    @default(5.0)
  batchLotId  String
  updatedAt   DateTime @updatedAt

  @@unique([shopId, productId])
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  customerId        String
  customer          User          @relation(fields: [customerId], references: [id])
  shopId            String
  shop              Shop          @relation(fields: [shopId], references: [id])
  addressId         String
  address           Address       @relation(fields: [addressId], references: [id])
  workerId          String?
  worker            Worker?       @relation(fields: [workerId], references: [id])
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  
  status            OrderStatus   @default(CREATED)
  totalAmount       Float
  discountAmount    Float         @default(0.0)
  deliveryFee       Float         @default(30.0)
  finalAmount       Float
  deliveryOtp       String        @default("1234")
  estimatedMins     Int           @default(24)
  notes             String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  orderItems        OrderItem[]
  payments          Payment[]
  liveSessions      LiveSession[]
  reviews           Review[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  cutType     CutType  @default(CURRY_CUT)
  marinade    String?  @default("None")
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
}

model LiveSession {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker     @relation(fields: [workerId], references: [id])
  cameraId     String
  camera       Camera     @relation(fields: [cameraId], references: [id])
  status       LiveStatus @default(OFFLINE)
  viewersCount Int        @default(1)
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  streamUrl    String?
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  paymentMethod     PaymentMethod @default(RAZORPAY)
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Float
  createdAt         DateTime      @default(now())
}

model DeliveryPartner {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType  String      @default("Electric Scooter")
  vehicleNo    String
  latitude     Float       @default(19.0760)
  longitude    Float       @default(72.8777)
  status       RiderStatus @default(AVAILABLE)
  walletEarned Float       @default(0.0)
  rating       Float       @default(4.9)
  createdAt    DateTime    @default(now())

  orders Order[]
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  discountPct   Float
  maxDiscount   Float
  minOrderValue Float    @default(299.0)
  isActive      Boolean  @default(true)
  expiresAt     DateTime
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
