# FreshTrust Production & Development Environment Variables

# Database & Storage
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freshtrust_db?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT & Authentication
JWT_SECRET="freshtrust_jwt_super_secret_key_production_2026_99x"
JWT_EXPIRES_IN="7d"

# Razorpay Payments Integration
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_fresh_trust_key_id"
RAZORPAY_KEY_SECRET="rzp_test_fresh_trust_secret_key"
RAZORPAY_WEBHOOK_SECRET="whsec_fresh_trust_webhook_992"

# Realtime & Live Butcher Cam WebRTC / LiveKit / Agora
NEXT_PUBLIC_WEBRTC_SIGNALING_URL="wss://localhost:8000/live-stream/signaling"
NEXT_PUBLIC_SOCKET_SERVER_URL="http://localhost:8000"
AGORA_APP_ID="agora_app_id_mock_production"
AGORA_APP_CERTIFICATE="agora_certificate_mock"

# Cloud & Storage (AWS S3 / Supabase)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="freshtrust-media-bucket"
AWS_ACCESS_KEY_ID="AKIA_FRESH_TRUST_TEST"
AWS_SECRET_ACCESS_KEY="secret_access_key_test"

# Email & SMS Gateway
RESEND_API_KEY="re_fresh_trust_key"
MSG91_AUTH_KEY="msg91_auth_key_test"

# Server Port
PORT=8000
NODE_ENV="development"
